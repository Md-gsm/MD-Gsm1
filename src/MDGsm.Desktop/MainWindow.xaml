                          <DataTrigger Binding="{Binding Status}" Value="آماده تحویل">
                            <Setter TargetName="StatusPill" Property="Background" Value="#D1FAE5"/>
                            <Setter TargetName="StatusPillText" Property="Foreground" Value="#047857"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="تحویل داده شده">
                            <Setter TargetName="StatusPill" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="StatusPillText" Property="Foreground" Value="#475569"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
