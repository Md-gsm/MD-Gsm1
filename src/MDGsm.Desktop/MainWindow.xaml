<Window x:Class="MDGsm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نرم‌افزار جامع مدیریت و حسابداری تعمیرگاه موبایل | MD-Gsm v0.2.11 — پیش‌نمایش"
        Height="900" Width="1440" MinHeight="600" MinWidth="900" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FlowDirection="RightToLeft" Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13.2"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="Slate950" Color="#020617"/>
    <SolidColorBrush x:Key="Slate900" Color="#0F172A"/>
    <SolidColorBrush x:Key="Slate800" Color="#1E293B"/>
    <SolidColorBrush x:Key="Slate700" Color="#334155"/>
    <SolidColorBrush x:Key="Slate600" Color="#475569"/>
    <SolidColorBrush x:Key="Slate500" Color="#64748B"/>
    <SolidColorBrush x:Key="Slate400" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>

    <Style x:Key="TopMenuButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#243B5B"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#38577F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickActionButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#475569"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#475569"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#64748B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CascadeMenuButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FEF3C7"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F2C94C"/>
                <Setter Property="Foreground" Value="#111827"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FDE68A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#94A3B8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ReceptionTabButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="17"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>

    <Style x:Key="AlignedDataGridTextStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <!-- Delivery priority is rendered by a dedicated first (right-edge in RTL) DataGrid column. -->
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="ToolTip" Value="{Binding MarkerLabel}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F8FAFC"/>
        </Trigger>
        <DataTrigger Binding="{Binding CustomerType}" Value="همکار">
          <Setter Property="Background" Value="#FAF7FF"/>
          <Setter Property="BorderBrush" Value="#EDE9FE"/>
        </DataTrigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DBEAFE"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="35"/>
    </Grid.RowDefinitions>

    <!-- Header matches the HTML reference order: top navigation, brand/actions, then dropdown. -->
    <Grid x:Name="HeaderRoot" Grid.Row="0" MouseLeave="HeaderRoot_MouseLeave">
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="70"/>
      </Grid.RowDefinitions>

    <!-- The top-level menus are hover-only. They never become workspace tabs. -->
    <Border x:Name="NavigationHost" Grid.Row="0" MouseLeave="NavigationHost_MouseLeave" Background="#0F172A" BorderBrush="#263449"
            BorderThickness="0,0,0,1">
      <StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="RightToLeft">
          <ItemsControl x:Name="MainMenuItemsControl" ItemsSource="{Binding MainMenus}" Margin="10,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource TopMenuButtonStyle}" MouseEnter="NavMenuButton_MouseEnter"
                        AutomationProperties.Name="{Binding Title}">
                  <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="{Binding IconGlyph}" Foreground="{Binding AccentBrush}" FontSize="15.4"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <TextBlock Text="{Binding Title}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="⌄" FontSize="12.1" Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </StackPanel>
    </Border>

    <!-- Product identity is anchored on the physical right; quick actions are anchored on the physical left. -->
    <Border Grid.Row="1" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,4">
      <Grid x:Name="BrandActionsLayout" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Full product identity and live Persian date/time, on the physical right side of the bar. -->
        <StackPanel x:Name="ProductBrandBlock" Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Margin="14,0,4,0">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                      FlowDirection="LeftToRight" Margin="0,0,12,0">
            <Border Width="48" Height="42" CornerRadius="11" Background="#FBBF24" Margin="0,0,0,1"
                    BorderBrush="#FDE68A" BorderThickness="1" ToolTip="نرم‌افزار جامع مدیریت و حسابداری تعمیرگاه موبایل">
              <Grid>
                <TextBlock Text="MD" Foreground="#0F172A" FontSize="22.5" FontWeight="Black"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Border Width="8" Height="8" CornerRadius="4" Background="#0F172A"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
              </Grid>
            </Border>
            <TextBlock Text="MD-Gsm" Foreground="#F59E0B" FontSize="13.2" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="RightToLeft">
            <TextBlock Text="نرم‌افزار جامع مدیریت و حسابداری تعمیرگاه موبایل"
                       Foreground="#FBBF24" FontSize="15.4" FontWeight="Black" TextAlignment="Right"/>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,3,0,0">
              <TextBlock Text="نسخه پیش‌نمایش ۰٫۲٫۱۰" Foreground="#94A3B8" FontSize="13.2"/>
              <TextBlock Text="  •  " Foreground="#475569" FontSize="13.2"/>
              <TextBlock x:Name="LiveDateTimeText" Text="محیط نمایشی" Foreground="#CBD5E1" FontSize="13.2"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Main quick actions are on the physical left side of the brand bar. -->
        <StackPanel x:Name="QuickActionsBlock" Grid.Column="0" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="RightToLeft" Margin="4,0,14,0">
          <Button Content="＋ پذیرش جدید" Click="QuickActionButton_Click" Tag="QCK-01"
                  Background="#2563EB" BorderBrush="#2563EB" Style="{StaticResource QuickActionButtonStyle}"/>
          <Button Content="♧ پذیرش همکار" Click="QuickActionButton_Click" Tag="QCK-02"
                  Background="#7C3AED" BorderBrush="#7C3AED" Style="{StaticResource QuickActionButtonStyle}"/>
          <Button Content="▦ ماشین‌حساب" Click="QuickActionButton_Click" Tag="QCK-03"
                  Background="#334155" BorderBrush="#475569" Style="{StaticResource QuickActionButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>

    </Grid>

    <!-- Cascading hover menu is a Popup anchored below the hovered top-level menu; it overlays the page and never creates a tab. -->
    <Popup x:Name="RootMenuPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" />

    <!-- Dashboard rebuilt from the supplied visual reference; all row/chart values are synthetic display fixtures. -->
    <Grid Grid.Row="1" Background="#F1F5F9">
      <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    SizeChanged="DashboardView_SizeChanged">
        <StackPanel x:Name="DashboardContentPanel" HorizontalAlignment="Stretch" Margin="0">
          <!-- KPI cards: same four-card row and color language as the reference. -->
          <UniformGrid Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCardStyle}">
              <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="13" Background="#EFF6FF" Margin="0,0,0,0">
                  <TextBlock Text="▣" Foreground="#2563EB" FontSize="26.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                  <TextBlock Text="کل پذیرش‌های ثبت‌شده" Foreground="#64748B" FontSize="14.3"/>
                  <TextBlock Text="۱۲" Foreground="#0F172A" FontSize="29.7" FontWeight="Black" Margin="0,3,0,1"/>
                  <TextBlock Text="۶ دستگاه امروز" Foreground="#2563EB" FontSize="13.2" FontWeight="SemiBold"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
              <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="13" Background="#FFF7ED">
                  <TextBlock Text="ϟ" Foreground="#EA580C" FontSize="30.8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                  <TextBlock Text="تحویل فوری و امروز" Foreground="#64748B" FontSize="14.3"/>
                  <TextBlock Text="۵" Foreground="#EA580C" FontSize="29.7" FontWeight="Black" Margin="0,3,0,1"/>
                  <TextBlock Text="نیازمند بررسی سریع" Foreground="#E11D48" FontSize="13.2" FontWeight="SemiBold"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
              <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="13" Background="#ECFDF5">
                  <TextBlock Text="✓" Foreground="#059669" FontSize="26.4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                  <TextBlock Text="آماده تحویل به مشتری" Foreground="#64748B" FontSize="14.3"/>
                  <TextBlock Text="۴" Foreground="#059669" FontSize="29.7" FontWeight="Black" Margin="0,3,0,1"/>
                  <TextBlock Text="پیامک ارسال‌شده: ۴" Foreground="#059669" FontSize="13.2" FontWeight="SemiBold"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0">
              <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="13" Background="#F0FDFA">
                  <TextBlock Text="＄" Foreground="#0D9488" FontSize="24.2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                  <TextBlock Text="کارمزد دریافتی امروز" Foreground="#64748B" FontSize="14.3"/>
                  <TextBlock Text="۴,۲۵۰,۰۰۰ تومان" Foreground="#0F172A" FontSize="22" FontWeight="Black" Margin="0,3,0,1"/>
                  <TextBlock Text="+۱۵٪ نسبت به روز قبل · مقدار نمونه" Foreground="#0D9488" FontSize="13.2" FontWeight="SemiBold"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </UniformGrid>

          <!-- Reception worklist -->
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" ClipToBounds="True">
            <StackPanel>
              <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10">
                <WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                  <Button x:Name="TabDeliveryToday" Tag="deliveryToday" Click="ReceptionTabButton_Click" Style="{StaticResource ReceptionTabButtonStyle}"
                          Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="#059669" Margin="0,0,6,0"/><TextBlock Text="تحویل امروز"/><Border Background="#D1FAE5" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"><TextBlock x:Name="TabDeliveryTodayCount" Text="۴" Foreground="#047857" FontSize="13.2"/></Border></StackPanel>
                  </Button>
                  <Button x:Name="TabIntakeToday" Tag="intakeToday" Click="ReceptionTabButton_Click" Style="{StaticResource ReceptionTabButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#2563EB" Margin="0,0,6,0"/><TextBlock Text="ورودی امروز"/><Border Background="#DBEAFE" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"><TextBlock x:Name="TabIntakeTodayCount" Text="۶" Foreground="#1D4ED8" FontSize="13.2"/></Border></StackPanel>
                  </Button>
                  <Button x:Name="TabTech" Tag="tech" Click="ReceptionTabButton_Click" Style="{StaticResource ReceptionTabButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="#D97706" Margin="0,0,6,0"/><TextBlock Text="مراحل تعمیر نزد تکنسین‌ها"/><Border Background="#E2E8F0" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"><TextBlock x:Name="TabTechCount" Text="۶" Foreground="#334155" FontSize="13.2"/></Border></StackPanel>
                  </Button>
                  <Button x:Name="TabPartner" Tag="partner" Click="ReceptionTabButton_Click" Style="{StaticResource ReceptionTabButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="♧" Foreground="#9333EA" Margin="0,0,6,0"/><TextBlock Text="گوشی‌های ورودی همکاران"/><Border Background="#E2E8F0" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"><TextBlock x:Name="TabPartnerCount" Text="۳" Foreground="#334155" FontSize="13.2"/></Border></StackPanel>
                  </Button>
                  <Button x:Name="TabAll" Tag="all" Click="ReceptionTabButton_Click" Style="{StaticResource ReceptionTabButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#475569" Margin="0,0,6,0"/><TextBlock Text="کلیه گوشی‌های ورودی (لیست کامل)"/><Border Background="#E2E8F0" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"><TextBlock x:Name="TabAllCount" Text="۱۲" Foreground="#334155" FontSize="13.2"/></Border></StackPanel>
                  </Button>
                </WrapPanel>
              </Border>

              <Grid Margin="10,8,10,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF" CornerRadius="8" Padding="10,0" Height="32" Margin="0,0,8,0">
                  <DockPanel>
                    <TextBlock Text="⌕" FontSize="20.9" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="ReceptionSearchBox" TextChanged="ReceptionSearchBox_TextChanged" BorderThickness="0" Background="Transparent"
                             Foreground="#334155" FontSize="14.3" VerticalContentAlignment="Center"
                             ToolTip="جست‌وجو در رکوردهای نمایشی" />
                  </DockPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                  <ComboBox x:Name="ReceptionStatusFilter" Width="135" Height="32" SelectedIndex="0" SelectionChanged="ReceptionStatusFilter_SelectionChanged"
                            FontSize="14.3" VerticalContentAlignment="Center" Margin="0,0,8,0">
                    <ComboBoxItem Content="همه وضعیت‌ها" Tag="all"/>
                    <ComboBoxItem Content="در حال بررسی" Tag="در حال بررسی"/>
                    <ComboBoxItem Content="منتظر قطعه" Tag="منتظر قطعه"/>
                    <ComboBoxItem Content="آماده تحویل" Tag="آماده تحویل"/>
                    <ComboBoxItem Content="تحویل داده شده" Tag="تحویل داده شده"/>
                  </ComboBox>
                  <Button Content="✦  اولویت‌بندی هوشمند تحویل" Click="SortByPriorityButton_Click" Background="#F1F5F9" Foreground="#334155"
                          BorderBrush="#E2E8F0" BorderThickness="1" Padding="9,6" FontSize="13.2" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
              </Grid>

              <DataGrid x:Name="ReceptionGrid" ItemsSource="{Binding ReceptionRows}" AutoGenerateColumns="False"
                        IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" Height="350" MinHeight="44"
                        Margin="10,0,10,0" HorizontalAlignment="Stretch"
                        Background="#FFFFFF" BorderThickness="0" FontSize="14.3" FlowDirection="RightToLeft"
                        RowHeight="49" CanUserResizeColumns="False" CanUserReorderColumns="False" EnableRowVirtualization="False"
                        SelectionMode="Single" SelectionUnit="FullRow" AlternatingRowBackground="#F8FAFC"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <!-- Explicit per-row strip at the physical right edge (first column in RTL). -->
                  <DataGridTemplateColumn Header="" Width="3.3" MinWidth="3.3" MaxWidth="3.3" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                      <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
