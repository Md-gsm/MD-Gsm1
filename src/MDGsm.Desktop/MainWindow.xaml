                      <DataTemplate>
                        <TextBlock Text="{Binding Code}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Right">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#334155"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomerType}" Value="همکار">
                                  <Setter Property="Foreground" Value="#8B5CF6"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="مشتری" Width="1.3*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,1">
                          <TextBlock Text="{Binding Customer}" Foreground="#1E293B" FontSize="13.2" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding CustomerPhone}" Foreground="#94A3B8" FontSize="12.1" TextAlignment="Right"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="مدل دستگاه" Binding="{Binding Device}" Width="1.15*" ElementStyle="{StaticResource AlignedDataGridTextStyle}"/>
                  <DataGridTextColumn Header="ایراد / مشکل اعلامی" Binding="{Binding Problem}" Width="1.8*" ElementStyle="{StaticResource AlignedDataGridTextStyle}"/>
                  <DataGridTextColumn Header="تکنسین مسئول" Binding="{Binding Technician}" Width="1.05*" ElementStyle="{StaticResource AlignedDataGridTextStyle}"/>
