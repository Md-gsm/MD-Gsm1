                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="در حال بررسی">
                            <Setter TargetName="StatusPill" Property="Background" Value="#DBEAFE"/>
                            <Setter TargetName="StatusPillText" Property="Foreground" Value="#1D4ED8"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="منتظر قطعه">
                            <Setter TargetName="StatusPill" Property="Background" Value="#FFEDD5"/>
                            <Setter TargetName="StatusPillText" Property="Foreground" Value="#C2410C"/>
